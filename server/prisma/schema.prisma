generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HospitalSettings {
  id           String   @id @default(uuid()) @db.Uuid
  hospitalName String   @default("Health Care") @map("hospital_name")
  contact      String?
  email        String?
  address      String?
  city         String?
  tagline      String?  @default("Caring for Life")
  currency     String   @default("PKR")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("hospital_settings")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  color       String   @default("#0D9488")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  doctors      Doctor[]
  appointments Appointment[]

  @@index([isActive])
  @@map("departments")
}

model Doctor {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  qualification  String?
  specialization String?
  departmentId   String?  @map("department_id") @db.Uuid
  contact        String?
  email          String?
  fee            Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  department   Department?   @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  visits       Visit[]

  @@index([departmentId])
  @@index([isActive])
  @@map("doctors")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Patient {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @unique @map("patient_id")
  name             String
  fatherName       String?  @map("father_name")
  age              Int?
  ageUnit          String   @default("Years") @map("age_unit")
  gender           String?
  contact          String?
  emergencyContact String?  @map("emergency_contact")
  address          String?
  bloodGroup       String?  @map("blood_group")
  cnic             String?
  allergies        String?
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  visits       Visit[]

  @@index([name])
  @@index([createdAt])
  @@map("patients")
}

model Appointment {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  doctorId        String?  @map("doctor_id") @db.Uuid
  departmentId    String?  @map("department_id") @db.Uuid
  appointmentDate DateTime @map("appointment_date") @db.Date
  appointmentTime String?  @map("appointment_time")
  tokenNumber     Int?     @map("token_number")
  status          String   @default("Scheduled")
  type            String   @default("OPD")
  fee             Decimal  @default(0) @db.Decimal(10, 2)
  isPaid          Boolean  @default(false) @map("is_paid")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  patient    Patient     @relation(fields: [patientId], references: [id])
  doctor     Doctor?     @relation(fields: [doctorId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([appointmentDate])
  @@index([status])
  @@index([patientId])
  @@map("appointments")
}

model Drug {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  genericName    String?   @map("generic_name")
  brand          String?
  category       String?
  form           String    @default("Tablet")
  strength       String?
  stockQuantity  Int       @default(0) @map("stock_quantity")
  reorderLevel   Int       @default(10) @map("reorder_level")
  salePrice      Decimal   @default(0) @map("sale_price") @db.Decimal(10, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([name])
  @@index([category])
  prescriptionLines PrescriptionLine[]

  @@index([isActive])
  @@map("drugs")
}

model LabTest {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  category    String?
  price       Decimal  @default(0) @db.Decimal(10, 2)
  normalRange String?  @map("normal_range")
  unit        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  prescriptionLines PrescriptionLine[]

  @@index([category])
  @@map("lab_tests")
}

model Visit {
  id              String   @id @default(uuid()) @db.Uuid
  visitNumber     String   @unique @map("visit_number")
  patientId       String   @map("patient_id") @db.Uuid
  doctorId        String?  @map("doctor_id") @db.Uuid
  visitDate       DateTime @default(now()) @map("visit_date")
  weightKg        Decimal? @map("weight_kg") @db.Decimal(6, 2)
  bloodPressure   String?  @map("blood_pressure")
  temperature     Decimal? @db.Decimal(5, 2)
  bloodSugar      Decimal? @map("blood_sugar") @db.Decimal(6, 2)
  pulse           Int?
  spo2            Int?
  diagnosis       String?
  advice          String?
  consultationFee Decimal  @default(0) @map("consultation_fee") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  patient Patient            @relation(fields: [patientId], references: [id])
  doctor  Doctor?            @relation(fields: [doctorId], references: [id])
  lines   PrescriptionLine[]
  bill    Bill?

  @@index([patientId])
  @@index([visitDate])
  @@index([doctorId])
  @@map("visits")
}

model PrescriptionLine {
  id        String  @id @default(uuid()) @db.Uuid
  visitId   String  @map("visit_id") @db.Uuid
  lineType  String  @map("line_type")
  drugId    String? @map("drug_id") @db.Uuid
  labTestId String? @map("lab_test_id") @db.Uuid
  name      String
  dosage    String?
  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @map("unit_price") @db.Decimal(10, 2)
  amount    Decimal @default(0) @db.Decimal(10, 2)

  visit   Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  drug    Drug?    @relation(fields: [drugId], references: [id])
  labTest LabTest? @relation(fields: [labTestId], references: [id])

  @@index([visitId])
  @@map("prescription_lines")
}

model Bill {
  id         String   @id @default(uuid()) @db.Uuid
  visitId    String   @unique @map("visit_id") @db.Uuid
  billNumber String   @unique @map("bill_number")
  subtotal   Decimal  @db.Decimal(10, 2)
  discount   Decimal  @default(0) @db.Decimal(10, 2)
  total      Decimal  @db.Decimal(10, 2)
  isPaid     Boolean  @default(false) @map("is_paid")
  createdAt  DateTime @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("bills")
}

model SystemCounter {
  name  String @id
  value Int    @default(1000)

  @@map("system_counters")
}
