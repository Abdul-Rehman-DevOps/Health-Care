{
  "name": "health-care",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["server"],
  "scripts": {
    "start": "docker compose up --build -d",
    "stop": "docker compose down",
    "restart": "docker compose down && docker compose up --build -d",
    "logs": "docker compose logs -f",
    "logs:api": "docker compose logs -f api",
    "up": "docker compose up --build",
    "build": "docker compose build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "db:backup": "docker compose exec -T db pg_dump -U healthcare -d healthcare --no-owner --clean --if-exists",
    "db:volume:inspect": "docker volume inspect health-care_pgdata"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.64.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-musl": "^4.27.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.2"
  }
}
